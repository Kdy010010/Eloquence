#!/usr/bin/env python3
import sys
from eas import Assembler, AssemblyError

def main():
    if len(sys.argv) != 2:
        print('Usage: eas <source-file>')
        return 1
    path = sys.argv[1]
    with open(path, 'r') as f:
        source = f.read()
    assembler = Assembler()
    try:
        code = assembler.assemble(source)
    except AssemblyError as e:
        print(f'Error: {e}', file=sys.stderr)
        return 1
    # Output machine code as space-separated hex bytes
    print(' '.join(f'{byte:02x}' for byte in code))
    return 0

if __name__ == '__main__':
    raise SystemExit(main())
